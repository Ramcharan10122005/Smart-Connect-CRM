generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  REP
}

enum LifecycleStage {
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum StageType {
  OPEN
  WON
  LOST
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  SYSTEM
}

enum FollowUpStatus {
  PENDING
  DONE
  SNOOZED
  CANCELLED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_STAGE_CHANGED
  LEAD_STALE_IN_STAGE
  FOLLOWUP_OVERDUE
  CONTACT_CREATED
}

enum AutomationAction {
  CREATE_FOLLOWUP
  SEND_EMAIL_TEMPLATE
  ASSIGN_OWNER
  ADD_TAG
  NOTIFY_USER
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id                      String                @id @default(uuid())
  name                    String
  email                   String                @unique
  passwordHash            String
  role                    Role                  @default(REP)
  phone                   String?
  avatarUrl               String?
  isActive                Boolean               @default(true)
  lastLoginAt             DateTime?
  notificationPreferences Json?                 @default("{\"email\": true, \"inApp\": true}")
  inviteToken             String?               @unique
  inviteExpiresAt         DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  // Relationships
  ownedCompanies          Company[]             @relation("CompanyOwner")
  ownedContacts           Contact[]             @relation("ContactOwner")
  ownedLeads              Lead[]                @relation("LeadOwner")
  assignedFollowUps       FollowUp[]            @relation("FollowUpAssignee")
  createdFollowUps        FollowUp[]            @relation("FollowUpCreator")
  createdActivities       Activity[]            @relation("ActivityCreator")
  notifications           Notification[]
  auditLogs               AuditLog[]
  stageChanges            LeadStageHistory[]    @relation("LeadStageChangedBy")
  passwordResetTokens     PasswordResetToken[]
  ownedCaptureForms       CaptureForm[]         @relation("CaptureFormDefaultOwner")
  createdTemplates        EmailTemplate[]       @relation("TemplateCreator")
  sentEmailLogs           EmailLog[]            @relation("EmailLogSender")
  createdRules            AutomationRule[]      @relation("RuleCreator")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id           String        @id @default(uuid())
  name         String
  domain       String?
  industry     String?
  size         String?
  website      String?
  phone        String?
  addressLine1 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  notes        String?       @db.Text
  ownerId      String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner        User?         @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  leads        Lead[]
  activities   Activity[]
  tags         CompanyTag[]

  @@index([ownerId])
  @@index([deletedAt])
  @@index([name])
}

model Contact {
  id              String         @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  jobTitle        String?
  companyId       String?
  ownerId         String?
  lifecycleStage  LifecycleStage @default(PROSPECT)
  sourceId        String?
  addressLine1    String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  linkedinUrl     String?
  notes           String?        @db.Text
  lastContactedAt DateTime?
  emailOptOut     Boolean        @default(false)
  optOutAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner           User?          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  source          LeadSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  leads           Lead[]         @relation("ContactLeads")
  convertedFrom   Lead[]         @relation("ConvertedContactLead")
  activities      Activity[]
  followUps       FollowUp[]
  tags            ContactTag[]
  emailLogs       EmailLog[]

  @@index([email])
  @@index([companyId])
  @@index([ownerId])
  @@index([sourceId])
  @@index([deletedAt])
}

model Tag {
  id          String       @id @default(uuid())
  name        String       @unique
  color       String       @default("#6366F1")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contactTags ContactTag[]
  companyTags CompanyTag[]
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
}

model CompanyTag {
  companyId String
  tagId     String
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@index([companyId])
  @@index([tagId])
}

model LeadSource {
  id           String        @id @default(uuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  contacts     Contact[]
  leads        Lead[]
  captureForms CaptureForm[] @relation("CaptureFormDefaultSource")
}

model PipelineStage {
  id               String             @id @default(uuid())
  name             String
  position         Int
  probability      Int                @default(0)
  type             StageType          @default(OPEN)
  color            String             @default("#6366F1")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  leads            Lead[]
  fromStageHistory LeadStageHistory[] @relation("LeadStageHistoryFrom")
  toStageHistory   LeadStageHistory[] @relation("LeadStageHistoryTo")

  @@index([position])
}

model Lead {
  id                 String             @id @default(uuid())
  title              String
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  companyName        String?
  companyId          String?
  contactId          String?
  value              Decimal            @default(0) @db.Decimal(12, 2)
  currency           String             @default("USD")
  sourceId           String?
  stageId            String
  ownerId            String?
  score              Int                @default(0)
  priority           Priority           @default(MEDIUM)
  expectedCloseDate  DateTime?
  status             LeadStatus         @default(OPEN)
  lostReason         String?            @db.Text
  convertedContactId String?
  convertedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  stage              PipelineStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner              User?              @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  source             LeadSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact            Contact?           @relation("ContactLeads", fields: [contactId], references: [id], onDelete: SetNull)
  convertedContact   Contact?           @relation("ConvertedContactLead", fields: [convertedContactId], references: [id], onDelete: SetNull)
  stageHistory       LeadStageHistory[]
  activities         Activity[]
  followUps          FollowUp[]
  emailLogs          EmailLog[]

  @@index([stageId])
  @@index([ownerId])
  @@index([sourceId])
  @@index([companyId])
  @@index([contactId])
  @@index([convertedContactId])
  @@index([status])
  @@index([deletedAt])
}

model LeadStageHistory {
  id          String        @id @default(uuid())
  leadId      String
  fromStageId String?
  toStageId   String
  changedById String?
  changedAt   DateTime      @default(now())

  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage? @relation("LeadStageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     PipelineStage @relation("LeadStageHistoryTo", fields: [toStageId], references: [id], onDelete: Restrict)
  changedBy   User?         @relation("LeadStageChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([changedById])
}

model Activity {
  id              String       @id @default(uuid())
  type            ActivityType
  subject         String
  body            String?      @db.Text
  outcome         String?
  durationMinutes Int?
  occurredAt      DateTime     @default(now())
  contactId       String?
  companyId       String?
  leadId          String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([createdById])
}

model FollowUp {
  id           String         @id @default(uuid())
  title        String
  description  String?        @db.Text
  dueAt        DateTime
  priority     Priority       @default(MEDIUM)
  status       FollowUpStatus @default(PENDING)
  recurrence   Recurrence     @default(NONE)
  contactId    String?
  leadId       String?
  assigneeId   String?
  createdById  String?
  completedAt  DateTime?
  remindedAt   DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee     User?          @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dueAt])
  @@index([assigneeId])
  @@index([createdById])
  @@index([contactId])
  @@index([leadId])
  @@index([status])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String    @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model CaptureForm {
  id              String      @id @default(uuid())
  key             String      @unique
  name            String
  defaultSourceId String?
  defaultOwnerId  String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  defaultSource   LeadSource? @relation("CaptureFormDefaultSource", fields: [defaultSourceId], references: [id], onDelete: SetNull)
  defaultOwner    User?       @relation("CaptureFormDefaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)

  @@index([defaultSourceId])
  @@index([defaultOwnerId])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  subject     String
  body        String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?    @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String?  @db.Text
  status    String   // 'SENT' or 'FAILED'
  error     String?  @db.Text
  sentById  String?
  contactId String?
  leadId    String?
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  sentBy    User?    @relation("EmailLogSender", fields: [sentById], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([sentById])
  @@index([contactId])
  @@index([leadId])
  @@index([sentAt])
  @@index([status])
}

model AutomationRule {
  id           String            @id @default(uuid())
  name         String
  isActive     Boolean           @default(true)
  trigger      AutomationTrigger
  conditions   Json              @default("{}")
  action       AutomationAction
  actionConfig Json              @default("{}")
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  createdBy    User?             @relation("RuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  logs         AutomationLog[]

  @@index([trigger])
  @@index([isActive])
  @@index([createdById])
}

model AutomationLog {
  id         String         @id @default(uuid())
  ruleId     String
  entityType String         // 'Lead', 'Contact', 'FollowUp'
  entityId   String
  status     String         // 'SUCCESS', 'FAILED', 'SKIPPED'
  result     Json?
  error      String?        @db.Text
  executedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([entityType, entityId])
  @@index([ruleId, entityType, entityId])
  @@index([status])
  @@index([executedAt])
}
