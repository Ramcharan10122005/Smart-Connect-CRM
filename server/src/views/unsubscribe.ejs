<div class="container" style="padding-top: 48px; padding-bottom: 48px; text-align: center; max-width: 560px; margin: 0 auto;">
  <div class="card" style="padding: 48px 32px; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); border: 1px solid #e2e8f0;">
    <% if (success) { %>
      <div style="width: 56px; height: 56px; background: #ecfdf5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: #10b981; font-size: 28px;">
        ✓
      </div>
      <h1 class="card-title" style="font-size: 24px; font-weight: 700; color: #0f172a; margin-bottom: 12px;">Unsubscribed</h1>
      <p style="font-size: 14px; color: #475569; line-height: 1.6; margin-bottom: 24px;">
        <% if (contact && contact.email) { %>
          <strong><%= contact.email %></strong> has been successfully unsubscribed.
        <% } else { %>
          <%= message || 'You have been successfully unsubscribed from future sales and marketing emails.' %>
        <% } %>
      </p>
      <p style="font-size: 12px; color: #94a3b8;">
        You will no longer receive marketing communications from this sender.
      </p>
    <% } else { %>
      <div style="width: 56px; height: 56px; background: #fef2f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: #ef4444; font-size: 28px;">
        !
      </div>
      <h1 class="card-title" style="font-size: 24px; font-weight: 700; color: #0f172a; margin-bottom: 12px;">Link Expired or Invalid</h1>
      <p style="font-size: 14px; color: #475569; line-height: 1.6; margin-bottom: 24px;">
        <%= message || 'This unsubscribe link is invalid or has expired.' %>
      </p>
    <% } %>
  </div>
</div>

