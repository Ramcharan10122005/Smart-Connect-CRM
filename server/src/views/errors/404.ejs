<div class="container" style="text-align: center; padding: 48px 16px;">
  <div class="card" style="padding: 48px 32px;">
    <div style="font-size: 64px; font-weight: 800; color: var(--primary); margin-bottom: 8px;">404</div>
    <h1 class="card-title" style="font-size: 26px;">Page Not Found</h1>
    <p class="card-subtitle" style="margin: 12px 0 28px 0; font-size: 15px; color: var(--text-body);">
      <%= typeof message !== 'undefined' ? message : "The page or form you're looking for doesn't exist or has been deactivated." %>
    </p>
    <div>
      <a href="/" class="btn btn-primary">Return to Homepage</a>
    </div>
  </div>
</div>
